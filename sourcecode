import 'dart:math';
import 'package:flutter/material.dart';
import 'package:google_fonts/google_fonts.dart';

void main() {
  runApp(const FragmentAndroidXApp());
}

class FragmentAndroidXApp extends StatelessWidget {
  const FragmentAndroidXApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'FragmentAndroidXApp - Pro++',
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        useMaterial3: true,
        colorScheme: ColorScheme.fromSeed(seedColor: Colors.deepPurple),
        textTheme: GoogleFonts.poppinsTextTheme(),
      ),
      home: const FragmentProScreen(),
    );
  }
}

class FragmentModel {
  String title;
  Color color;
  double progress;
  bool enabled;
  bool expanded;
  IconData icon;

  FragmentModel({
    required this.title,
    required this.color,
    this.progress = 0.25,
    this.enabled = true,
    this.expanded = true,
    required this.icon,
  });

  FragmentModel cloneWithNewTitle(String newTitle) {
    return FragmentModel(
      title: newTitle,
      color: color,
      progress: progress,
      enabled: enabled,
      expanded: expanded,
      icon: icon,
    );
  }
}

class FragmentProScreen extends StatefulWidget {
  const FragmentProScreen({super.key});

  @override
  State<FragmentProScreen> createState() => _FragmentProScreenState();
}

class _FragmentProScreenState extends State<FragmentProScreen> {
  final List<FragmentModel> _fragments = [];
  int _counter = 1;
  final Random _rnd = Random();

  // to avoid FAB being too close to edge on wide screens
  final EdgeInsets fabMargin = const EdgeInsets.only(right: 18.0, bottom: 18.0);

  Color _randomColor() {
    // Pastel-like colors
    final h = _rnd.nextDouble() * 360;
    final s = 0.5 + _rnd.nextDouble() * 0.3; // saturation
    final l = 0.6 + _rnd.nextDouble() * 0.15; // lightness
    return HSLColor.fromAHSL(1, h, s, l).toColor();
  }

  IconData _randomIcon() {
    const icons = [
      Icons.widgets,
      Icons.palette,
      Icons.star,
      Icons.lightbulb,
      Icons.auto_graph,
      Icons.flash_on,
      Icons.favorite,
      Icons.bolt,
      Icons.layers,
      Icons.star_border_purple500_sharp,
    ];
    return icons[_rnd.nextInt(icons.length)];
  }

  void _addFragment({int atIndex = 0}) {
    setState(() {
      final model = FragmentModel(
        title: 'Fragment #${_counter++}',
        color: _randomColor(),
        progress: _rnd.nextDouble().clamp(0.05, 0.95),
        enabled: true,
        expanded: true,
        icon: _randomIcon(),
      );
      if (atIndex < 0 || atIndex > _fragments.length) {
        _fragments.add(model);
      } else {
        _fragments.insert(atIndex, model);
      }
    });
  }

  void _randomizeColors() {
    setState(() {
      for (var f in _fragments) {
        f.color = _randomColor();
      }
    });
  }

  void _duplicateFragment(int index) {
    setState(() {
      final original = _fragments[index];
      final clone = original.cloneWithNewTitle('${original.title} (copy)');
      _fragments.insert(index + 1, clone);
    });
  }

  void _removeFragment(int index) {
    setState(() {
      _fragments.removeAt(index);
    });
  }

  void _clearAll() {
    setState(() {
      _fragments.clear();
      _counter = 1;
    });
  }

  @override
  Widget build(BuildContext context) {
    final media = MediaQuery.of(context);
    final isWide = media.size.width > 720;

    return Scaffold(
      appBar: AppBar(
        title: const Text('Dynamic Fragment Manager — Pro++'),
        centerTitle: true,
        elevation: 2,
        flexibleSpace: Container(
          decoration: const BoxDecoration(
            gradient: LinearGradient(
              colors: [Color(0xFF7C4DFF), Color(0xFF6A1B9A)],
              begin: Alignment.topLeft,
              end: Alignment.bottomRight,
            ),
          ),
        ),
      ),
      // Side action buttons (left) + page
      body: SafeArea(
        child: Row(
          children: [
            // left action rail (compact) on wide screens
            if (isWide)
              Padding(
                padding: const EdgeInsets.symmetric(
                  horizontal: 12.0,
                  vertical: 16,
                ),
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    ElevatedButton.icon(
                      onPressed: () => _addFragment(atIndex: 0),
                      icon: const Icon(Icons.add),
                      label: const Text('Tambah Fragment'),
                      style: ElevatedButton.styleFrom(
                        shape: const StadiumBorder(),
                      ),
                    ),
                    const SizedBox(height: 8),
                    ElevatedButton.icon(
                      onPressed: _randomizeColors,
                      icon: const Icon(Icons.palette),
                      label: const Text('Random Colors'),
                      style: ElevatedButton.styleFrom(
                        shape: const StadiumBorder(),
                      ),
                    ),
                    const SizedBox(height: 8),
                    ElevatedButton.icon(
                      onPressed: _clearAll,
                      icon: const Icon(Icons.delete_sweep),
                      label: const Text('Clear All'),
                      style: ElevatedButton.styleFrom(
                        backgroundColor: Colors.redAccent,
                        shape: const StadiumBorder(),
                      ),
                    ),
                    const SizedBox(height: 12),
                    const RotatedBox(
                      quarterTurns: 3,
                      child: Text(
                        'Pro++ Mode',
                        style: TextStyle(
                          fontWeight: FontWeight.w600,
                          letterSpacing: 1.2,
                        ),
                      ),
                    ),
                  ],
                ),
              ),
            // main content
            Expanded(
              child: Container(
                color: const Color(0xFFF7F5FF),
                child: Column(
                  children: [
                    const SizedBox(height: 18),
                    // Header banner
                    Padding(
                      padding: const EdgeInsets.symmetric(horizontal: 22.0),
                      child: Row(
                        children: [
                          Expanded(
                            child: Text(
                              'Manage dynamic fragments — add, reorder, swipe to delete, expand, and duplicate. UI dibuat menarik agar tugasmu dipuji dosen ✨',
                              style: Theme.of(context).textTheme.titleMedium
                                  ?.copyWith(
                                    fontSize: isWide ? 18 : 15,
                                    color: Colors.black87,
                                  ),
                            ),
                          ),
                          if (!isWide) const SizedBox(width: 8),
                          if (!isWide)
                            IconButton(
                              onPressed: () => _addFragment(atIndex: 0),
                              icon: const Icon(Icons.add_circle, size: 32),
                              color: Colors.deepPurple,
                            ),
                        ],
                      ),
                    ),
                    const SizedBox(height: 12),
                    Expanded(
                      child: _fragments.isEmpty
                          ? _emptyState()
                          : Padding(
                              padding: const EdgeInsets.symmetric(
                                horizontal: 14.0,
                                vertical: 8,
                              ),
                              child: ReorderableListView.builder(
                                buildDefaultDragHandles: true,
                                itemCount: _fragments.length,
                                onReorder: (oldIndex, newIndex) {
                                  setState(() {
                                    if (newIndex > oldIndex) newIndex -= 1;
                                    final item = _fragments.removeAt(oldIndex);
                                    _fragments.insert(newIndex, item);
                                  });
                                },
                                itemBuilder: (context, index) {
                                  final f = _fragments[index];
                                  return Dismissible(
                                    key: ValueKey(f.title + index.toString()),
                                    direction: DismissDirection.endToStart,
                                    background: Container(
                                      alignment: Alignment.centerRight,
                                      padding: const EdgeInsets.symmetric(
                                        horizontal: 20,
                                      ),
                                      decoration: BoxDecoration(
                                        color: Colors.redAccent.withOpacity(
                                          0.95,
                                        ),
                                        borderRadius: BorderRadius.circular(18),
                                      ),
                                      child: const Icon(
                                        Icons.delete,
                                        color: Colors.white,
                                      ),
                                    ),
                                    onDismissed: (_) => _removeFragment(index),
                                    child: Padding(
                                      key: ValueKey('tile_$index'),
                                      padding: const EdgeInsets.symmetric(
                                        vertical: 8.0,
                                      ),
                                      child: FragmentCard(
                                        model: f,
                                        onToggleExpand: () {
                                          setState(() {
                                            f.expanded = !f.expanded;
                                          });
                                        },
                                        onChangedProgress: (p) {
                                          setState(() {
                                            f.progress = p;
                                          });
                                        },
                                        onToggleEnabled: (val) {
                                          setState(() {
                                            f.enabled = val;
                                          });
                                        },
                                        onDuplicate: () =>
                                            _duplicateFragment(index),
                                        onRemove: () => _removeFragment(index),
                                      ),
                                    ),
                                  );
                                },
                              ),
                            ),
                    ),
                  ],
                ),
              ),
            ),
          ],
        ),
      ),
      // FAB area with margin so it's not stuck to right
      floatingActionButtonLocation: FloatingActionButtonLocation.endDocked,
      floatingActionButton: Padding(
        padding: fabMargin,
        child: FloatingActionButton.extended(
          onPressed: () => _addFragment(atIndex: 0),
          icon: const Icon(Icons.add),
          label: const Text('Tambah Fragment'),
          backgroundColor: Colors.deepPurple,
          elevation: 8,
        ),
      ),
    );
  }

  Widget _emptyState() {
    return Center(
      child: Column(
        mainAxisSize: MainAxisSize.min,
        children: [
          Text(
            'Belum ada fragment.',
            style: TextStyle(fontSize: 22, color: Colors.black54),
          ),
          const SizedBox(height: 6),
          Text(
            'Tekan tombol + untuk menambah. Swipe kanan-kiri untuk hapus.\nTarik lalu lepas untuk reorder.',
            style: TextStyle(fontSize: 14, color: Colors.black38),
            textAlign: TextAlign.center,
          ),
          const SizedBox(height: 18),
          ElevatedButton.icon(
            onPressed: () => _addFragment(atIndex: 0),
            icon: const Icon(Icons.auto_fix_high),
            label: const Text('Tambahkan Contoh Fragment'),
            style: ElevatedButton.styleFrom(shape: const StadiumBorder()),
          ),
        ],
      ),
    );
  }
}

class FragmentCard extends StatelessWidget {
  final FragmentModel model;
  final VoidCallback onToggleExpand;
  final ValueChanged<double> onChangedProgress;
  final ValueChanged<bool> onToggleEnabled;
  final VoidCallback onDuplicate;
  final VoidCallback onRemove;

  const FragmentCard({
    super.key,
    required this.model,
    required this.onToggleExpand,
    required this.onChangedProgress,
    required this.onToggleEnabled,
    required this.onDuplicate,
    required this.onRemove,
  });

  @override
  Widget build(BuildContext context) {
    final borderRadius = BorderRadius.circular(16.0);
    final shadowColor = Colors.black12;

    return AnimatedContainer(
      duration: const Duration(milliseconds: 350),
      decoration: BoxDecoration(
        borderRadius: borderRadius,
        gradient: LinearGradient(
          colors: [
            model.color.withOpacity(0.12),
            model.color.withOpacity(0.06),
          ],
          begin: Alignment.topLeft,
          end: Alignment.bottomRight,
        ),
        boxShadow: [
          BoxShadow(
            color: shadowColor,
            blurRadius: 10,
            offset: const Offset(0, 6),
          ),
        ],
      ),
      child: ClipRRect(
        borderRadius: borderRadius,
        child: Material(
          color: Colors.white.withOpacity(0.001),
          child: Column(
            children: [
              // header row
              ListTile(
                tileColor: Colors.white.withOpacity(0.0001),
                leading: CircleAvatar(
                  radius: 26,
                  backgroundColor: model.color,
                  child: Icon(
                    model.icon,
                    color: useWhiteForeground(model.color)
                        ? Colors.white
                        : Colors.black87,
                  ),
                ),
                title: Text(
                  model.title,
                  style: TextStyle(
                    fontWeight: FontWeight.bold,
                    color: Colors.black87,
                    fontSize: 17,
                  ),
                ),
                subtitle: Text(
                  model.enabled ? 'Enabled' : 'Disabled',
                  style: TextStyle(
                    color: model.enabled
                        ? Colors.green.shade700
                        : Colors.red.shade400,
                    fontWeight: FontWeight.w600,
                  ),
                ),
                trailing: Row(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    IconButton(
                      tooltip: 'Duplicate',
                      icon: const Icon(Icons.copy),
                      onPressed: onDuplicate,
                    ),
                    IconButton(
                      tooltip: 'Remove',
                      icon: const Icon(Icons.close),
                      onPressed: onRemove,
                    ),
                    // drag handle is provided automatically by ReorderableListView if buildDefaultDragHandles true,
                    // but we also show expand/collapse:
                    IconButton(
                      tooltip: model.expanded ? 'Collapse' : 'Expand',
                      icon: AnimatedRotation(
                        duration: const Duration(milliseconds: 300),
                        turns: model.expanded ? 0.5 : 0.0,
                        child: const Icon(Icons.expand_more),
                      ),
                      onPressed: onToggleExpand,
                    ),
                  ],
                ),
              ),

              // content (expandable)
              AnimatedCrossFade(
                firstChild: Container(),
                secondChild: Padding(
                  padding: const EdgeInsets.symmetric(
                    horizontal: 20.0,
                    vertical: 12,
                  ),
                  child: Column(
                    children: [
                      // progress row
                      Row(
                        children: [
                          Expanded(
                            child: Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: [
                                Text(
                                  'Progress',
                                  style: TextStyle(
                                    color: Colors.black54,
                                    fontWeight: FontWeight.w600,
                                  ),
                                ),
                                const SizedBox(height: 6),
                                ClipRRect(
                                  borderRadius: BorderRadius.circular(12),
                                  child: LinearProgressIndicator(
                                    minHeight: 10,
                                    value: model.progress,
                                    backgroundColor: Colors.black12,
                                    valueColor: AlwaysStoppedAnimation(
                                      model.color,
                                    ),
                                  ),
                                ),
                                const SizedBox(height: 8),
                                Slider(
                                  value: model.progress,
                                  onChanged: onChangedProgress,
                                  min: 0,
                                  max: 1,
                                ),
                              ],
                            ),
                          ),
                        ],
                      ),

                      const SizedBox(height: 8),

                      // switch and small description
                      Row(
                        mainAxisAlignment: MainAxisAlignment.spaceBetween,
                        children: [
                          Expanded(
                            child: Text(
                              'Ini deskripsi singkat fragment. Fungsinya hanya untuk tampilan tugasmu — interaktif dan enak dilihat.',
                              style: TextStyle(color: Colors.black54),
                            ),
                          ),
                          const SizedBox(width: 16),
                          Column(
                            children: [
                              Text(
                                'Active',
                                style: TextStyle(color: Colors.black54),
                              ),
                              const SizedBox(height: 6),
                              Switch(
                                value: model.enabled,
                                onChanged: onToggleEnabled,
                                activeColor: model.color,
                              ),
                            ],
                          ),
                        ],
                      ),

                      const SizedBox(height: 12),

                      // action buttons
                      Row(
                        children: [
                          ElevatedButton.icon(
                            onPressed: () {},
                            icon: const Icon(Icons.open_in_new),
                            label: const Text('Open'),
                            style: ElevatedButton.styleFrom(
                              backgroundColor: model.color,
                              foregroundColor: useWhiteForeground(model.color)
                                  ? Colors.white
                                  : Colors.black87,
                              shape: RoundedRectangleBorder(
                                borderRadius: BorderRadius.circular(12),
                              ),
                            ),
                          ),
                          const SizedBox(width: 10),
                          OutlinedButton.icon(
                            onPressed: () {},
                            icon: const Icon(Icons.info_outline),
                            label: const Text('Details'),
                            style: OutlinedButton.styleFrom(
                              shape: RoundedRectangleBorder(
                                borderRadius: BorderRadius.circular(12),
                              ),
                            ),
                          ),
                        ],
                      ),
                    ],
                  ),
                ),
                crossFadeState: model.expanded
                    ? CrossFadeState.showSecond
                    : CrossFadeState.showFirst,
                duration: const Duration(milliseconds: 300),
                firstCurve: Curves.easeOut,
                secondCurve: Curves.easeIn,
              ),
            ],
          ),
        ),
      ),
    );
  }

  // from flutter/material.dart ColorUtils: determines white/black foreground
  static bool useWhiteForeground(Color backgroundColor, {double bias = 0.0}) {
    // Perceived luminance
    final double v = sqrt(
      pow(backgroundColor.red, 2) * 0.241 +
          pow(backgroundColor.green, 2) * 0.691 +
          pow(backgroundColor.blue, 2) * 0.068,
    );
    return v < 200 + bias;
  }
}
